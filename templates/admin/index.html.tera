{% extends "base" %}
{% block title %}Admin Dashboard{% endblock title %}
{% block content %}
<div class="container py-5">
    <h2>Admin Dashboard</h2>
    <div class="list-group mt-4" style="max-width: 480px">
        {% set admin_menu_class = "list-group-item list-group-item-action" %}
        {% set admin_menu_descriptions = true %}
        {% include "admin/menu" %}
    </div>
</div>
{% endblock content %}
