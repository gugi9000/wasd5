{% extends "base" %}
{% block title %}{{ album.title }} - Comics{% endblock title %}
{% block content %}
<a href="/comics">All comics</a>
{% if album.banner_filename %}
<img src="/comics/{{ album.id }}/banner" alt="Banner art for {{ album.title }}" class="mt-3" decoding="async" style="height: auto" />
{% endif %}
<div class="d-flex justify-content-between align-items-start gap-3 mt-3 flex-wrap">
  <h1>{{ album.title }}</h1>
  {% if can_manage %}
  <div class="d-flex gap-2 flex-wrap">
    <a class="btn btn-outline-primary" href="/comics/{{ album.id }}/edit">Edit album</a>
    <a class="btn btn-primary" href="/comics/{{ album.id }}/strips/new">Add strip / page</a>
  </div>
  {% endif %}
</div>
<p class="text-muted small">By {{ owner }} · Created {{ album.created_at | date(format="%Y-%m-%d") }} · Updated {{ album.updated_at | date(format="%Y-%m-%d") }}</p>
{% if album.hidden %}<p><span class="badge text-bg-warning">Hidden album</span> Only the owner and admins can view this album or its images.</p>{% endif %}
{% if album.subtext %}<p style="white-space: pre-wrap; overflow-wrap: anywhere">{{ album.subtext }}</p>{% endif %}
{% if strips | length == 0 %}
<p class="text-muted">No strips to show yet.</p>
{% else %}
  {% for strip in strips %}
  <article id="strip-{{ strip.id }}" class="border-top pt-4 mt-4">
    <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-2">
      <h2 class="h4 mb-0">{{ strip.title }}</h2>
      {% if can_manage %}<a class="btn btn-sm btn-outline-primary" href="/comics/{{ album.id }}/strips/{{ strip.id }}/edit">Edit strip</a>{% endif %}
    </div>
    {% if strip.hidden %}<p><span class="badge text-bg-warning">Hidden strip</span></p>{% endif %}
    <figure>
      <a href="/comics/{{ album.id }}/strips/{{ strip.id }}/image" aria-label="Open full image: {{ strip.title }}">
        <img src="/comics/{{ album.id }}/strips/{{ strip.id }}/image" alt="{{ strip.title }}" loading="lazy" decoding="async" style="height: auto" />
      </a>
      {% if strip.subtext %}<figcaption class="mt-2" style="white-space: pre-wrap; overflow-wrap: anywhere">{{ strip.subtext }}</figcaption>{% endif %}
    </figure>
  </article>
  {% endfor %}
{% endif %}
{% endblock content %}
