{% extends "base" %}
{% block title %}Cards Elemental{% endblock title %}
{% block main_class %}col-12 mb-4{% endblock main_class %}
{% block sidebar %}{% endblock sidebar %}
{% block content %}
<link rel="stylesheet" href="/static/cards-elemental.css" />
<section id="cards-elemental" data-csrf="{{ csrf }}">
    <header class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-3">
        <div>
            <h1>Cards Elemental</h1>
            <p class="mb-0">Play against the server or challenge someone online.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <label for="cards-opponent" class="visually-hidden">Solo opponent</label>
            <select id="cards-opponent" class="form-select w-auto" aria-label="Solo opponent">
                <option value="tosser">Tosser (random)</option>
                <option value="pro">Pro (strategic)</option>
                <option value="pro2">Pro2 (colour + defence)</option>
            </select>
            <button id="cards-new-game" class="btn btn-outline-primary" type="button">Play solo</button>
            <button id="cards-start-public" class="btn btn-primary" type="button">Create public game</button>
            <button id="cards-start-private" class="btn btn-outline-primary" type="button">Create private game</button>
        </div>
    </header>

    <section id="cards-online-lobby" class="cards-online-lobby card p-3 mb-4" aria-labelledby="cards-online-title">
        <h2 id="cards-online-title" class="h5">Join a game</h2>
        <div class="d-flex gap-2 flex-wrap align-items-end mb-3">
            <label class="flex-grow-1" for="cards-join-id">
                Private game ID
                <input id="cards-join-id" class="form-control" autocomplete="off" spellcheck="false">
            </label>
            <button id="cards-join-button" class="btn btn-secondary" type="button">Join by ID</button>
        </div>
        <h3 class="h6">Open public games</h3>
        <ul id="cards-open-games" class="list-group"></ul>
        <p id="cards-no-open-games" class="text-muted mb-0">No public games are waiting.</p>
    </section>

    <section id="cards-game-id-section" class="alert alert-info d-flex gap-2 flex-wrap align-items-center" hidden>
        <span>Share this game ID with your opponent:</span>
        <code id="cards-game-id"></code>
        <button id="cards-copy-game-id" class="btn btn-sm btn-outline-primary" type="button">Copy ID</button>
    </section>

    <p id="cards-status" class="alert alert-secondary" role="status" aria-live="polite">
        Start a game to draw your hand.
    </p>
    <section id="cards-round-result" class="cards-round-result mb-4" aria-live="polite" hidden></section>

    <div class="cards-game-layout">
        <section aria-labelledby="your-hand-title">
            <h2 id="your-hand-title" class="h4">Your hand</h2>
            <p id="cards-turn-hint" class="text-muted">Choose a card to play.</p>
            <div id="cards-hand" class="cards-hand"></div>
        </section>
        <aside class="cards-side">
            <section class="cards-pile card p-3">
                <h2 class="h5">Draw pile
                    <span class="cards-deck-count-wrap">
                        <span id="cards-deck-count" class="badge text-bg-secondary" tabindex="0" aria-describedby="cards-deck-stats">0</span>
                        <span id="cards-deck-stats" class="cards-deck-stats" role="tooltip">
                            <strong>Deck exhaustion odds:</strong> Emptying the initial 110-card draw pile takes 55 rounds. In 500,000 random-play simulations, none reached that point before a player won; games averaged 7 rounds and the longest lasted 25. That puts a 95% upper bound near 0.0006% (under 1 in 167,000) for random play—not an exact estimate for strategic players. Try as you might.
                        </span>
                    </span>
                </h2>
                <p class="mb-0 text-muted">Unseen cards available to draw.</p>
            </section>
            <section class="cards-pile card p-3">
                <h2 class="h5">Your winnings <span id="your-winnings-count" class="badge text-bg-secondary">0</span></h2>
                <div id="your-winnings" class="cards-winnings"></div>
            </section>
            <section class="cards-pile card p-3">
                <h2 class="h5">Opponent winnings <span id="server-winnings-count" class="badge text-bg-secondary">0</span></h2>
                <div id="server-winnings" class="cards-winnings"></div>
            </section>
        </aside>
    </div>
    <p id="cards-error" class="text-danger mt-3 mb-0" role="alert"></p>
    <div class="cards-rules card p-3 mt-4">
        <h2 class="h5">How to play</h2>
        <ul class="mb-0">
            <li>Solo opponents: Tosser plays randomly; Pro works toward either winning set; Pro2 favours colours only after winning a matching element/colour pair, and blocks imminent wins at any time. Neither strategic bot sees your hidden cards.</li>
            <li>Each player starts with five cards. On your turn, choose one card to play.</li>
            <li>Fire beats ice, ice beats water, and water beats fire. Matching elements compare values; equal values draw.</li>
            <li>The round winner keeps their own card. Draws discard both played cards. Players draw back up while cards are available.</li>
            <li>When the draw pile runs out, discarded cards that nobody won are shuffled back in. Won cards stay out of play.</li>
            <li>Win by collecting all three elements, or three cards with the same colour and element.</li>
            <li>The first player is chosen randomly. The leader plays a hidden card, then the other player chooses a response. The round winner leads next; after a draw, the same player leads again.</li>
        </ul>
    </div>
    <p id="cards-message" class="text-muted mt-3 mb-0">Concieved April 13, 2020. Finally unleashed in 2026.</p>
    <section class="cards-pile card p-3 mt-4" aria-labelledby="cards-statistics-title">
        <h2 id="cards-statistics-title" class="h5">Completed games</h2>
        <dl class="d-flex gap-4 flex-wrap mb-0">
            {% for stat in statistics %}
            <div>
                <dt>{% if stat.category == "pvp" %}PvP{% elif stat.category == "private" %}PvP (private){% elif stat.category == "tosser" %}Solo Tosser{% elif stat.category == "pro" %}Solo Pro{% else %}Solo Pro2{% endif %}</dt>
                <dd id="cards-stat-{{ stat.category }}" class="mb-0">{{ stat.completed }}</dd>
            </div>
            {% endfor %}
        </dl>
        <p class="text-muted small mt-2 mb-0">Counts games finished with a winner or draw, not abandoned games.</p>
    </section>
</section>
<script src="/static/cards-elemental.js" defer></script>
{% endblock content %}
