{% extends "base" %}
{% block title %}Minesweeper winning board{% endblock title %}
{% block main_class %}col-12 mb-4{% endblock main_class %}
{% block sidebar %}{% endblock sidebar %}
{% block content %}
<link rel="stylesheet" href="/static/minesweeper.css" />
<h1>Minesweeper winning board</h1>
<p>{{ score.player_name }} {% include "games/score_identity" %} · {{ score.mode | capitalize }} · {{ (score.elapsed_ms / 1000) | round(precision=1) }} s</p>
{% if score.board %}
<div class="board-scroll">
    {% set miniature = false %}
    {% include "games/minesweeper_snapshot" %}
</div>
<p class="mt-2">Read-only snapshot saved with this score. Mines are shown; flags reflect the winning move.</p>
{% else %}
<p>No board was saved for this older score.</p>
{% endif %}
<p class="mt-3"><a href="/games/minesweeper">Back to Minesweeper and leaderboards</a></p>
{% endblock content %}
